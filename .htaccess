# Custom 404 Error Page

ErrorDocument 404 /src/php/404.php

# General URL Rewriting

RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^$ src/php/index.php [L]

RewriteCond %{DOCUMENT_ROOT}/src/php/$1.php -f
RewriteRule ^([A-Za-z0-9\-_]+)/?$ src/php/$1.php [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/src/php/$1 -f
RewriteRule ^([A-Za-z0-9\-_]+\.php)$ src/php/$1 [L,QSA]

# SEO URL Rewriting

RewriteRule ^administracia$ src/php/admin.php [L]
RewriteRule ^moj-ucet$ src/php/edit_account.php [L]
RewriteRule ^upravit-recenziu$ src/php/edit_review.php [L]
RewriteRule ^domov$ src/php/index.php [L]
RewriteRule ^prihlasenie$ src/php/login.php [L]
RewriteRule ^obnova-hesla$ src/php/password_reset.php [L]
RewriteRule ^registracia$ src/php/registration.php [L]
RewriteRule ^objednavka-uspesna$ src/php/success_order.php [L]