# Copy This File To .env And Fill In The Values (.env Is Never Committed)

# Database (PostgreSQL)

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=pcexpert
POSTGRES_USER=
POSTGRES_PASSWORD=

# Mail (Gmail)

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=465
# False On PORT 465
EMAIL_USE_TLS=False
EMAIL_BACKEND=

# Google reCAPTCHA V3

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Stripe

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# stripe login And Then stripe listen --forward-to http://pcexpert.local/src/php/api/stripe_webhook.php For Temporary Secret Or Register Testing Domain On Ngrok For Static Secret
STRIPE_WEBHOOK_SECRET=
